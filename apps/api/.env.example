# Local development. Supabase runtime: transaction pooler, port 6543,
# with ?pgbouncer=true&connection_limit=1. Never expose these to the frontend.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/redemption?schema=public"
# Supabase migrations: session pooler, port 5432.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/redemption?schema=public"
PORT=3001
# Required when authentication and Redis are implemented in later steps.
JWT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Seed runs fail unless an explicit development password is supplied.
SEED_MEMBER_PASSWORD=
